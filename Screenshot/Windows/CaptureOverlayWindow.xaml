<Window x:Class="Screenshot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas" Background="#59000000">
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#673AB7"
                   StrokeThickness="2"
                   RadiusX="2"
                   RadiusY="2"
                   Fill="#26673AB7" />
        <Border x:Name="HintPanel"
                Canvas.Left="20"
                Canvas.Top="20"
                Background="#F0323232"
                CornerRadius="12"
                Padding="16,10"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <TextBlock x:Name="HintTextBlock"
                       Foreground="White"
                       FontSize="13"
                       Opacity="0.95"
                       Text="拖动鼠标选择区域，松开保存；Esc 取消" />
        </Border>
    </Canvas>
</Window>
