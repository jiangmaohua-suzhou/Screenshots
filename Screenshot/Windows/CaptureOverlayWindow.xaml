<Window x:Class="Screenshot.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas" Background="#66000000">
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#FF0078D4"
                   StrokeThickness="2"
                   StrokeDashArray="4 2"
                   Fill="#220078D4" />
        <Border x:Name="HintPanel"
                Canvas.Left="16"
                Canvas.Top="16"
                Background="#CC1E1E1E"
                CornerRadius="6"
                Padding="12,8">
            <TextBlock x:Name="HintTextBlock"
                       Foreground="White"
                       FontSize="13"
                       Text="拖动鼠标选择区域，松开保存；Esc 取消" />
        </Border>
    </Canvas>
</Window>
