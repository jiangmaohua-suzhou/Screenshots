<Window x:Class="Screenshot.Windows.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录屏中"
        Width="220"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="#E61E1E1E"
            CornerRadius="10"
            BorderBrush="#FF444444"
            BorderThickness="1"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="10"
                     Height="10"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Fill="#FFE81123" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="正在录屏"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock x:Name="DurationTextBlock"
                           Margin="0,2,0,0"
                           Text="00:00:00"
                           Foreground="#FFCCCCCC"
                           FontSize="12" />
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="StopButton"
                    Content="停止"
                    Width="56"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="StopButton_Click" />
        </Grid>
    </Border>
</Window>
