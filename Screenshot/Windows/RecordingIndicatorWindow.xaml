<Window x:Class="Screenshot.Windows.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="录屏中"
        Width="260"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="Manual">
    <materialDesign:Card Padding="16,12"
                         UniformCornerRadius="12"
                         materialDesign:ElevationAssist.Elevation="Dp8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="36"
                    Height="36"
                    Margin="0,0,14,0"
                    CornerRadius="18"
                    Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                    Opacity="0.15">
                <materialDesign:PackIcon Kind="RecordRec"
                                         Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           Text="正在录屏" />
                <TextBlock x:Name="DurationTextBlock"
                           Margin="0,2,0,0"
                           Opacity="0.72"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Text="00:00" />
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="StopButton"
                    Margin="12,0,0,0"
                    Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.ValidationError}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="StopButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Stop"
                                             VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="停止" />
                </StackPanel>
            </Button>
        </Grid>
    </materialDesign:Card>
</Window>
