<Window x:Class="Screenshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="截图录屏工具"
        Height="520"
        Width="720"
        MinHeight="480"
        MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Closing="MainWindow_Closing">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Text="截图录屏" />
        </StackPanel>

        <!-- Settings -->
        <materialDesign:Card Grid.Row="1"
                             Margin="0,0,0,16"
                             Padding="24"
                             UniformCornerRadius="12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Text="保存设置" />

                <TextBox x:Name="SaveFolderTextBox"
                         Margin="0,16,0,0"
                         materialDesign:HintAssist.Hint="文件夹路径"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextChanged="SaveFolderTextBox_TextChanged" />

                <StackPanel Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="BrowseFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen"
                                                     VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="浏览" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenFolderButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OpenFolderButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Folder"
                                                     VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="打开" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <CheckBox x:Name="RecordAudioCheckBox"
                          Margin="0,16,0,0"
                          Content="录屏时录制系统声音"
                          Checked="RecordAudioCheckBox_Changed"
                          Unchecked="RecordAudioCheckBox_Changed" />
            </StackPanel>
        </materialDesign:Card>

        <!-- Actions -->
        <materialDesign:Card Grid.Row="2"
                             Padding="24"
                             UniformCornerRadius="12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Screenshot -->
                <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,0,16"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Camera"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="截图" />
                    </StackPanel>

                    <UniformGrid Columns="2">
                        <Button x:Name="FullScreenButton"
                                Margin="0,0,6,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="FullScreenButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MonitorScreenshot"
                                                         VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="全屏" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="RegionButton"
                                Margin="6,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="RegionButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CropFree"
                                                         VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="区域" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="16,8"
                        Background="{DynamicResource MaterialDesignDivider}" />

                <!-- Recording -->
                <StackPanel Grid.Column="2">
                    <StackPanel Margin="0,0,0,16"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Video"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="录屏" />
                    </StackPanel>

                    <UniformGrid Columns="3">
                        <Button x:Name="FullScreenRecordButton"
                                Margin="0,0,4,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="FullScreenRecordButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Video"
                                                         VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="全屏" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="RegionRecordButton"
                                Margin="4,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="RegionRecordButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CropFree"
                                                         VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="区域" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="StopRecordButton"
                                Margin="4,0,0,0"
                                IsEnabled="False"
                                Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="StopRecordButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop"
                                                         VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="停止" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Status -->
        <materialDesign:Card x:Name="StatusPanel"
                             Grid.Row="3"
                             Margin="0,16,0,0"
                             Padding="16,12"
                             VerticalAlignment="Bottom"
                             UniformCornerRadius="8"
                             Visibility="Collapsed"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="StatusIcon"
                                         Width="20"
                                         Height="20"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"
                                         Kind="Information" />
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource MaterialDesignBody2TextBlock}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
