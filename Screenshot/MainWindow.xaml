<Window x:Class="Screenshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图录屏工具"
        Height="560"
        Width="620"
        MinHeight="520"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        Closing="MainWindow_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="截图录屏工具"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF1E1E1E" />
            <TextBlock Margin="0,6,0,0"
                       Text="支持截图、全屏/区域录屏，文件保存到自定义文件夹。"
                       Foreground="#FF666666"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                BorderBrush="#FFE5E5E5"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="保存文件夹"
                           FontWeight="SemiBold"
                           Foreground="#FF333333" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SaveFolderTextBox"
                             Grid.Column="0"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             BorderBrush="#FFD0D0D0"
                             TextChanged="SaveFolderTextBox_TextChanged" />

                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="16,0"
                            Height="36"
                            Content="浏览..."
                            Click="BrowseFolder_Click" />
                </Grid>

                <CheckBox x:Name="RecordAudioCheckBox"
                          Grid.Row="2"
                          Margin="0,12,0,0"
                          Content="录屏时录制系统声音"
                          Checked="RecordAudioCheckBox_Changed"
                          Unchecked="RecordAudioCheckBox_Changed" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="截图"
                       FontWeight="SemiBold"
                       Foreground="#FF333333"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FullScreenButton"
                        Content="全屏截图"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        FontSize="14"
                        Click="FullScreenButton_Click" />
                <Button x:Name="RegionButton"
                        Content="区域截图"
                        Width="130"
                        Height="40"
                        FontSize="14"
                        Click="RegionButton_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="录屏"
                       FontWeight="SemiBold"
                       Foreground="#FF333333"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FullScreenRecordButton"
                        Content="全屏录屏"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        FontSize="14"
                        Click="FullScreenRecordButton_Click" />
                <Button x:Name="RegionRecordButton"
                        Content="区域录屏"
                        Width="130"
                        Height="40"
                        FontSize="14"
                        Click="RegionRecordButton_Click" />
                <Button x:Name="StopRecordButton"
                        Content="停止录屏"
                        Width="130"
                        Height="40"
                        Margin="12,0,0,0"
                        FontSize="14"
                        IsEnabled="False"
                        Click="StopRecordButton_Click" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,20,0,0"
                Background="White"
                CornerRadius="8"
                Padding="16"
                BorderBrush="#FFE5E5E5"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近保存"
                               FontWeight="SemiBold"
                               Foreground="#FF333333" />
                    <Button Grid.Column="1"
                            x:Name="OpenFolderButton"
                            Content="打开文件夹"
                            Padding="12,4"
                            Click="OpenFolderButton_Click" />
                </Grid>

                <TextBlock x:Name="LastSavedTextBlock"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           Text="尚未保存任何文件"
                           Foreground="#FF666666"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="5"
                   Margin="0,16,0,0"
                   Foreground="#FF0078D4"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
